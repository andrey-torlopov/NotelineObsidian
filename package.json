{
  "name": "noteline",
  "version": "0.1.0",
  "description": "An interactive note timeline for Obsidian.",
  "private": true,
  "type": "module",
  "main": "main.js",
  "license": "MIT",
  "author": "andrey-torlopov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrey-torlopov/noteline.git"
  },
  "bugs": {
    "url": "https://github.com/andrey-torlopov/noteline/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "node scripts/validate-manifest.mjs && node esbuild.config.mjs --production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "check": "npm run validate:manifest && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "obsidian": "1.14.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
